{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^server-only$": "<rootDir>/__mocks__/server-only.js",
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "jsx": "react-jsx",
        "rootDir": ".",
        "paths": { "@/*": ["./*"] }
      }
    }]
  },
  "testMatch": ["**/__tests__/**/*.test.ts", "**/__tests__/**/*.test.tsx"]
}
